{
  "rewrites": [
    { "source": "/((?!assets|favicon|logo|manifest|robots|registerSW|workbox).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
